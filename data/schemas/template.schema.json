{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-studio.local/schemas/template.schema.json",
  "title": "Prompt Studio Template",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "modality",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "enum": [
        "image",
        "video",
        "3d",
        "audio",
        "text"
      ]
    },
    "description": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "selection",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "selection": {
            "enum": [
              "single",
              "multiple"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "prompt_fragment"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "prompt_fragment": {
                  "type": "string"
                },
                "preview_media_id": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "composition": {
      "type": "object"
    }
  },
  "additionalProperties": false
}